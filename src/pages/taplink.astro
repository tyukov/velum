---
// Визитка для ссылки в Instagram: эскиз дома, главные кнопки связи и список товаров.
// В поиск не нужна (noindex) — дублирует контакты сайта.
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import LeadModal from "../components/LeadModal.astro";
import { business } from "../lib/business";

const wa = `https://wa.me/${business.phoneE164.replace("+", "")}?text=${encodeURIComponent("Здравствуйте! Пишу из Instagram")}`;
const goods = [
  { name: "Металлочерепица", href: "/catalog/metallocherepitsa" },
  { name: "Профилированный лист" },
  { name: "Водосточная система" },
  { name: "Сайдинг, софит" },
  { name: "Доборные элементы кровли" },
  { name: "Элементы безопасности кровли" },
  { name: "Кровельная вентиляция" },
  { name: "Гидро- и пароизоляция" },
  { name: "Крепёж" },
  { name: "Подконструкция" },
  { name: "Мансардные окна" },
  { name: "Чердачные лестницы" },
  { name: "Фасадные кассеты" },
  { name: "Линеарные панели" },
  { name: "Металлический штакетник" },
  { name: "Сэндвич-панели" },
];
---

<Base
  title="Velum — контакты, товары и услуги"
  description="Velum: кровельные и фасадные материалы в Атырау. Каталог товаров и услуг, контакты, заявка на звонок."
  path="/taplink"
  noindex
  whatsapp={false}
>
  <main class="tl">
    <header class="tl__hero">
      <Logo class="logo" />
      <img src="/images/house-roof.svg" alt="" width="760" height="600" />
      <h1>Кровля и фасад в Атырау</h1>
      <p>Цены за м², расчёт под ваш дом, доставка</p>
    </header>

    <nav class="tl__actions" aria-label="Связаться с нами">
      <a href="#ex1" rel="modal:open" class="s-btn s-btn--dark">
        Оставить заявку
      </a>
      <a href={wa} target="_blank" rel="noopener" class="s-btn s-btn--wa">
        Написать в WhatsApp
      </a>
      <a href={`tel:${business.phoneE164}`} class="s-btn s-btn--light">
        Позвонить
      </a>
      <a href="/" class="s-btn s-btn--light">
        Наш сайт velum.kz
      </a>
      <a href="https://go.2gis.com/v1o8m" target="_blank" rel="noopener" class="s-btn s-btn--light">
        Как добраться (2ГИС)
      </a>
    </nav>

    <section class="tl__goods" aria-labelledby="tl-goods">
      <h2 id="tl-goods">Товары и услуги</h2>
      <ul>
        {goods.map((g) => (
          <li>{g.href ? <a href={g.href}>{g.name} →</a> : <span>{g.name}</span>}</li>
        ))}
      </ul>
      <p class="tl__hours">
        Работаем {business.hours} · {business.phoneDisplay}
      </p>
    </section>

    <p class="tl__legal">
      <a href="/privacy">Политика конфиденциальности</a>
    </p>
  </main>
  <LeadModal
    id="ex1"
    title="Оставьте заявку — перезвоним"
    submitText="Отправить заявку"
    withMessage
  />
</Base>

<style>
  .tl {
    box-sizing: border-box;
    max-width: 480px;
    margin: 0 auto;
    padding: 0 16px 32px;
  }
  .tl__hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 -16px;
    padding: 20px 20px 24px;
    border-radius: 0 0 28px 28px;
    background: var(--paper);
    text-align: center;
  }
  .tl__hero :global(.logo) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .tl__hero :global(.logo svg) {
    width: 117px;
    height: auto;
  }
  .tl__hero img {
    display: block;
    width: min(330px, 100%);
    height: auto;
    margin: 4px 0;
  }
  .tl__hero h1 {
    margin: 0 0 6px;
    font-size: 26px;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .tl__hero p {
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }
  .tl__actions {
    display: grid;
    gap: 10px;
    margin-top: 20px;
  }
  .tl__actions .s-btn {
    width: 100%;
    box-sizing: border-box;
  }
  .tl__goods {
    margin-top: 28px;
  }
  .tl__goods h2 {
    margin: 0 0 12px;
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }
  .tl__goods ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tl__goods li > * {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid #e3ddd3;
    border-radius: 18px;
    font-size: 14px;
    color: var(--ink);
    text-decoration: none;
  }
  .tl__goods li > a {
    border-color: var(--ink);
    font-weight: 600;
  }
  .tl__hours {
    margin: 16px 0 0;
    font-size: 14px;
    color: var(--muted);
  }
  .tl__legal {
    margin: 24px 0 0;
    text-align: center;
    font-size: 13px;
  }
  .tl__legal a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    color: var(--muted);
  }
</style>
