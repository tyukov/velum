---
import PageLayout from "../layouts/PageLayout.astro";
import { business } from "../lib/business";
---

<PageLayout
  title="Страница не найдена | Velum"
  description="Такой страницы нет. Перейдите на главную Velum или позвоните нам: 8 701 013 13 59."
  path="/404"
  noindex
  lead
>
  <section class="s-wrap s-done s-done_404">
    <div class="s-done__art" aria-hidden="true">
      <span class="s-done__code">404</span>
      <img src="/images/house-line.svg" alt="" width="760" height="600" />
    </div>
    <h1>Страница не найдена</h1>
    <p>
      Возможно, ссылка устарела. Перейдите на главную, в <a href="/catalog">каталог</a> или
      позвоните: <a href={`tel:${business.phoneE164}`}>{business.phoneDisplay}</a>.
    </p>
    <div class="s-done__actions">
      <a href="/" class="s-btn s-btn--dark">
        Вернуться на главную
      </a>
      <a href={`tel:${business.phoneE164}`} class="s-btn s-btn--light">
        Позвонить
      </a>
    </div>
  </section>
</PageLayout>
