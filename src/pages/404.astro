---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import "../styles/taplink.css";
---

<Base
  title="Страница не найдена | Velum"
  description="Такой страницы нет. Перейдите на главную Velum или позвоните нам: 8 701 013 13 59."
  path="/404"
  noindex
  bodyClass="page page-done"
>
  <div>
    <Logo />
  </div>
  <div class="page-done__middle">
    <h1 class="page-done__title">Страница не найдена</h1>
    <p class="page-done__description">
      Возможно, ссылка устарела. Перейдите на главную или позвоните:{" "}
      <a href="tel:+77010131359">8&nbsp;701&nbsp;013&nbsp;13&nbsp;59</a>
    </p>
  </div>
  <div class="page-done__bottom">
    <a href="/" class="btn btn_theme_grab btn_size_m btn_size_l">
      <span class="btn__text">Вернуться на главную</span>
    </a>
  </div>
</Base>
