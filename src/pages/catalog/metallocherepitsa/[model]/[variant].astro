---
import CatalogLayout from "../../../../layouts/CatalogLayout.astro";
import ProductView from "../../../../components/catalog/ProductView.astro";
import { colors } from "../../../../data/catalog/colors";
import {
  defaultVariant,
  formatPrice,
  formatThickness,
  priceOf,
  supplyNote,
  warrantyOf,
  metalTileModels,
  variantsOf,
  type Variant,
} from "../../../../data/catalog/metal-tile";

export function getStaticPaths() {
  return metalTileModels.flatMap((model) =>
    variantsOf(model).map((variant) => ({
      params: { model: model.slug, variant: variant.slug },
      props: { variant },
    })),
  );
}

const { variant } = Astro.props as { variant: Variant };
const { model, coating } = variant;
const color = colors[variant.color]!;
const colorText = color.label === color.name ? color.name : `${color.label} ${color.name}`;
const name = `Металлочерепица ${model.name} ${coating.name} ${formatThickness(coating.thickness)}, ${colorText}`;
const price = priceOf(model, coating);
const warranty = warrantyOf(model, coating);
const modelPath = `/catalog/metallocherepitsa/${model.slug}`;
// Первый вариант модели совпадает со страницей модели: каноническим считаем адрес модели
const isDefault = defaultVariant(model).slug === variant.slug;
---

<CatalogLayout
  title={`${name} в Атырау | Velum`}
  description={`${name}${price ? ` — ${formatPrice(price)} за м²` : ""}. Покрытие класса «${coating.class}»${warranty ? `, гарантия ${warranty} лет` : ""}. Доставка по Атырау, расчёт под ваш объём в Velum.`}
  path={`${modelPath}/${variant.slug}`}
  canonicalPath={isDefault ? modelPath : undefined}
  product={name}
  supply={supplyNote(model, coating)}
>
  <ProductView variant={variant} />
</CatalogLayout>
