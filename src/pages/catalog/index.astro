---
import CatalogLayout from "../../layouts/CatalogLayout.astro";
import Breadcrumbs from "../../components/catalog/Breadcrumbs.astro";
import TileVisual from "../../components/catalog/TileVisual.astro";
import { metalTileModels } from "../../data/catalog/metal-tile";
---

<CatalogLayout
  title="Каталог кровельных и фасадных материалов в Атырау | Velum"
  description="Каталог Velum: металлочерепица Металл Профиль и другие кровельные и фасадные материалы. Подбор цвета и покрытия, расчёт стоимости и доставка в Атырау."
  path="/catalog"
>
  <Breadcrumbs
    items={[
      { name: "Главная", href: "/" },
      { name: "Каталог", href: "/catalog" },
    ]}
  />
  <header class="catalog-head">
    <h1>Каталог</h1>
    <p>
      Продукция завода «Металл Профиль». Каталог пополняется: профнастил, водосточные системы,
      сайдинг и доборные элементы появятся в ближайшее время. Если нужного товара нет в списке,
      позвоните — подберём из полного ассортимента.
    </p>
  </header>

  <ul class="model-grid">
    <li class="model-card">
      <a href="/catalog/metallocherepitsa" class="model-card__link">
        <TileVisual hex="#45322E" label="Металлочерепица" size="small" />
        <h2 class="model-card__title">Металлочерепица</h2>
        <p class="model-card__text">{metalTileModels.map((m) => m.name).join(", ")}</p>
        <p class="model-card__meta">{metalTileModels.length} моделей</p>
      </a>
    </li>
  </ul>
</CatalogLayout>
