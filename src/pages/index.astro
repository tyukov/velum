---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeCategories from "../components/home/HomeCategories.astro";
import HomeCalc from "../components/home/HomeCalc.astro";
import HomeWhy from "../components/home/HomeWhy.astro";
import HomeSteps from "../components/home/HomeSteps.astro";
import HomeWorks from "../components/home/HomeWorks.astro";
import HomeReviews from "../components/home/HomeReviews.astro";
import FaqSection from "../components/FaqSection.astro";
import LeadModal from "../components/LeadModal.astro";
import Footer from "../components/Footer.astro";
import { business } from "../lib/business";
// Старые стили нужны окну заявки (.modal, .blocker)
import "../styles/style.css";

// WebSite — по нему Google и Яндекс показывают название сайта в выдаче
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${business.url}#website`,
      name: business.name,
      url: business.url,
      inLanguage: "ru",
      publisher: { "@id": `${business.url}#business` },
    },
    {
      "@type": "HomeAndConstructionBusiness",
      "@id": `${business.url}#business`,
      name: business.name,
      url: business.url,
      logo: new URL("/logo-x1.png", business.url).href,
      image: new URL("/og.jpg", business.url).href,
      description: business.description,
      telephone: business.phoneE164,
      sameAs: business.sameAs,
      priceRange: "₸₸",
      address: {
        "@type": "PostalAddress",
        addressLocality: business.city,
        addressCountry: "KZ",
      },
      areaServed: { "@type": "City", name: business.city },
    },
  ],
};
---

<Base
  title="Velum | Металлочерепица, профлист и водостоки в Атырау"
  description="Velum — магазин кровельных и фасадных материалов в Атырау: металлочерепица, профнастил, водосточные системы, сайдинг. Доставка, консультация, скидки до 50%."
  ogTitle="Velum — кровельные и фасадные материалы в Атырау"
  bar
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Header />
  <main class="main home">
    <HomeHero />
    <HomeCategories />
    <HomeCalc />
    <HomeWhy />
    <HomeSteps />
    <HomeWorks />
    <HomeReviews />
    <FaqSection />
  </main>
  <Footer />
  <LeadModal id="ex1" title="Оставьте заявку" submitText="Отправить заявку" withMessage />
  <LeadModal id="ex2" title="Заказать звонок" submitText="Заказать звонок" />
</Base>

<script>
  import "../scripts/home.ts";
</script>
