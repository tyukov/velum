---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import HeroSection from "../components/HeroSection.astro";
import BrandsSection from "../components/BrandsSection.astro";
import StepsSection from "../components/StepsSection.astro";
import FeaturesSection from "../components/FeaturesSection.astro";
import FaqSection from "../components/FaqSection.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
import PromoAdvSection from "../components/PromoAdvSection.astro";
import LeadModal from "../components/LeadModal.astro";
import Footer from "../components/Footer.astro";
import { business } from "../lib/business";
import "../styles/style.css";
// Фон первого экрана на компьютере (CSS background) — самый крупный элемент, грузим заранее
import desktopHero from "../assets/img/def.webp";

// WebSite — по нему Google и Яндекс показывают название сайта в выдаче
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${business.url}#website`,
      name: business.name,
      url: business.url,
      inLanguage: "ru",
      publisher: { "@id": `${business.url}#business` },
    },
    {
      "@type": "HomeAndConstructionBusiness",
      "@id": `${business.url}#business`,
      name: business.name,
      url: business.url,
      logo: new URL("/logo-x1.png", business.url).href,
      image: new URL("/og.jpg", business.url).href,
      description: business.description,
      telephone: business.phoneE164,
      priceRange: "₸₸",
      address: {
        "@type": "PostalAddress",
        addressLocality: business.city,
        addressCountry: "KZ",
      },
      areaServed: { "@type": "City", name: business.city },
    },
  ],
};
---

<Base
  title="Velum | Металлочерепица, профлист и водостоки в Атырау"
  description="Velum — магазин кровельных и фасадных материалов в Атырау: металлочерепица, профнастил, водосточные системы, сайдинг. Доставка, консультация, скидки до 50%."
  ogTitle="Velum — кровельные и фасадные материалы в Атырау"
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={desktopHero.src}
    media="(min-width: 67.5rem)"
    fetchpriority="high"
  />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Header />
  <main class="main">
    <HeroSection />
    <BrandsSection />
    <StepsSection />
    <FeaturesSection />
    <FaqSection />
    <ProjectsSection />
    <ReviewsSection />
    <PromoAdvSection />
  </main>
  <Footer />
  <LeadModal id="ex1" title="Оставьте заявку" submitText="Отправить заявку" withMessage />
  <LeadModal id="ex2" title="Заказать звонок" submitText="Заказать звонок" />
</Base>
