---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import done from "../assets/img/icons/done.svg";
import "../styles/taplink.css";
---

<Base
  title="Спасибо за заявку | Velum"
  description="Заявка отправлена. Менеджер Velum свяжется с вами в ближайшее время."
  path="/thanks"
  noindex
  bodyClass="page page-done"
>
  <div>
    <Logo />
  </div>
  <div class="page-done__middle">
    <Image src={done} alt="" />
    <h1 class="page-done__title">Спасибо, что оставили заявку!</h1>
    <p class="page-done__description">Мы свяжемся с вами в ближайшее время</p>
  </div>
  <div class="page-done__bottom">
    <a href="/" class="btn btn_theme_grab btn_size_m btn_size_l">
      <span class="btn__text">Вернуться на главную</span>
    </a>
  </div>
</Base>
