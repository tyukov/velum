---
import PageLayout from "../layouts/PageLayout.astro";
import { business } from "../lib/business";
---

<PageLayout
  title="Спасибо за заявку | Velum"
  description="Заявка отправлена. Менеджер Velum свяжется с вами в ближайшее время."
  path="/thanks"
  noindex
>
  <section class="s-wrap s-done">
    <span class="s-done__icon" aria-hidden="true">
      <svg
        width="40"
        height="40"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
      >
        <path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
    <h1>Спасибо, что оставили заявку!</h1>
    <p>
      Мы свяжемся с вами в ближайшее время. Пока можно посмотреть <a href="/catalog">каталог</a> или
      посчитать крышу в <a href="/#calc">калькуляторе</a>.
    </p>
    <div class="s-done__actions">
      <a href="/" class="s-btn s-btn--dark">
        Вернуться на главную
      </a>
      <a href={`tel:${business.phoneE164}`} class="s-btn s-btn--light">
        Позвонить
      </a>
    </div>
  </section>
</PageLayout>
