---
// Условная картинка листа металлочерепицы в выбранном цвете (фото появятся позже)
import { tileSvgContent } from "../../lib/tile-svg";
interface Props {
  hex: string;
  label: string;
  size?: "large" | "small";
}

const { hex, label, size = "large" } = Astro.props;
const id = `tile-${hex.slice(1)}-${size}`;
const content = tileSvgContent(hex, id);
---

<svg
  class={`tile-visual tile-visual_${size}`}
  viewBox="0 0 240 160"
  role="img"
  aria-label={label}
  preserveAspectRatio="xMidYMid slice"
  set:html={content}
/>

<style>
  .tile-visual {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1rem;
    aspect-ratio: 3 / 2;
  }
</style>
