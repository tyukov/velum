---
// Страница модели/варианта металлочерепицы: выбор покрытия, толщины и цвета
import Breadcrumbs from "./Breadcrumbs.astro";
import { colors, colorSlug } from "../../data/catalog/colors";
import {
  catalogEntries,
  defaultVariant,
  familyOf,
  modelFacts,
  formatPrice,
  formatThickness,
  minPrice,
  priceDateOf,
  priceOf,
  supplierPrices,
  warrantyOf,
  stockInfo,
  variantsOf,
  type Model,
  type Variant,
} from "../../data/catalog/metal-tile";
import { ROOF_TYPES, SLOPES } from "../../lib/roof";
import { tileImagePath } from "../../lib/tile-svg";
import { business } from "../../lib/business";
import { lookOf } from "../../data/catalog/tile-look";

interface Props {
  variant: Variant;
  /** Страница модели (а не варианта): разметка ProductGroup со всеми вариантами */
  isModelPage?: boolean;
}

const { variant, isModelPage = false } = Astro.props;
const { model, coating, color } = variant;
const base = `/catalog/metallocherepitsa/${model.slug}`;
const all = variantsOf(model);
const colorInfo = colors[color]!;

// Ссылка на вариант с нужным покрытием/толщиной: цвет сохраняем, если он есть
const linkTo = (name: string, thickness?: number) => {
  const sameName = all.filter((v) => v.coating.name === name);
  const pool = thickness ? sameName.filter((v) => v.coating.thickness === thickness) : sameName;
  const pick = pool.find((v) => v.color === color) ?? pool[0]!;
  return `${base}/${pick.slug}`;
};

const colorOptions = all.filter(
  (v) => v.coating.name === coating.name && v.coating.thickness === coating.thickness,
);
// Исполнения семейства (Монтерроса A/S/M/X): сохраняем покрытие, толщину и цвет, если есть
const versions = familyOf(model);
const versionLink = (m: Model) => {
  const vs = variantsOf(m);
  const pick =
    vs.find(
      (v) =>
        v.coating.name === coating.name &&
        v.coating.thickness === coating.thickness &&
        v.color === color,
    ) ??
    vs.find((v) => v.coating.name === coating.name && v.color === color) ??
    vs.find((v) => v.coating.name === coating.name) ??
    defaultVariant(m);
  return `/catalog/metallocherepitsa/${m.slug}/${pick.slug}`;
};
const price = priceOf(model, coating);
// Покрытия модели для сравнения в калькуляторе: сумма на ту же площадь
const calcOptions = model.coatings.flatMap((c) => {
  const p = priceOf(model, c);
  if (!p) return [];
  return [
    {
      name: `${c.name} ${formatThickness(c.thickness)}`,
      price: p,
      inStock: c.stock === "atyrau",
      href: linkTo(c.name, c.thickness),
      current: c === coating,
    },
  ];
});
const warranty = warrantyOf(model, coating);
const stock = stockInfo[coating.stock];
// Покрытия, которые есть в Атырау (хотя бы в одной толщине)
const inStockNames = new Set(model.coatings.filter((c) => c.stock === "atyrau").map((c) => c.name));
const site = Astro.site ?? new URL("https://velum.kz");
const productName = `Металлочерепица ${model.name} ${coating.name} ${formatThickness(coating.thickness)}, ${colorInfo.label}`;
const modelUrl = new URL(base, site).href;
// Вариант для разметки: название, цвет, цена и наличие
const variantLd = (v: Variant) => {
  const info = colors[v.color]!;
  const vPrice = priceOf(model, v.coating);
  return {
    "@type": "Product",
    name: `Металлочерепица ${model.name} ${v.coating.name} ${formatThickness(v.coating.thickness)}, ${info.label}`,
    url: new URL(`${base}/${v.slug}`, site).href,
    image: new URL(tileImagePath(colorSlug(v.color)), site).href,
    color: info.label === info.name ? info.name : `${info.label} ${info.name}`,
    material: `Оцинкованная сталь ${formatThickness(v.coating.thickness)}, покрытие ${v.coating.name}`,
    ...(vPrice && {
      offers: {
        "@type": "Offer",
        price: vPrice,
        priceCurrency: "KZT",
        availability:
          v.coating.stock === "atyrau"
            ? "https://schema.org/InStock"
            : "https://schema.org/BackOrder",
        seller: { "@type": "Organization", name: business.name },
      },
    }),
  };
};
// Страница модели — ProductGroup со всеми вариантами; страница варианта — Product этой группы
const productLd = isModelPage
  ? {
      "@context": "https://schema.org",
      "@type": "ProductGroup",
      "@id": modelUrl,
      name: `Металлочерепица ${model.name}`,
      description: model.summary,
      url: modelUrl,
      image: new URL(tileImagePath(colorSlug(color)), site).href,
      productGroupID: model.slug,
      variesBy: ["https://schema.org/color", "https://schema.org/material"],
      hasVariant: all.map(variantLd),
    }
  : {
      "@context": "https://schema.org",
      ...variantLd(variant),
      description: model.summary,
      isVariantOf: { "@type": "ProductGroup", "@id": modelUrl },
    };

const look = lookOf(model.slug, model.family?.id);
// Покрытия карточками (покрытие + толщина), от дешёвых к дорогим: класс, толщина, цена,
// гарантия (если не у двух поставщиков) или число цветов
const coatingCards = model.coatings
  .map((c) => {
    const w = warrantyOf(model, c);
    return {
      c,
      href: linkTo(c.name, c.thickness),
      price: priceOf(model, c),
      active: c === coating,
      inStock: c.stock === "atyrau",
      extra: w ? `гарантия ${w} лет` : `${c.colors.length} цв.`,
    };
  })
  .sort((a, b) => (a.price ?? Infinity) - (b.price ?? Infinity));
// Исполнения семейства (Монтерроса A/S/M/X): цена «от», ширина, число покрытий
const versionCards = versions.map((m) => ({
  m,
  href: versionLink(m),
  from: minPrice([m]),
  coatings: new Set(m.coatings.map((c) => c.name)).size,
}));
const colorText =
  colorInfo.label === colorInfo.name ? colorInfo.name : `${colorInfo.label} ${colorInfo.name}`;
const variantName = `${coating.name} ${formatThickness(coating.thickness)} · ${colorInfo.label}`;
// Тот же цвет в других покрытиях этой модели (для страницы варианта)
const sameColor = all
  .filter((v) => v.color === color && v.coating !== coating)
  .map((v) => ({ v, price: priceOf(model, v.coating) }))
  .sort((a, b) => (a.price ?? Infinity) - (b.price ?? Infinity));
const waLink = (text: string) =>
  `https://wa.me/${business.phoneE164.replace("+", "")}?text=${encodeURIComponent(text)}`;
const waProduct = waLink(
  `Здравствуйте! Пишу с сайта velum.kz: металлочерепица ${model.name}, ${coating.name} ${formatThickness(coating.thickness)}, ${colorInfo.label}`,
);
const extras = [
  { title: "Конёк", text: "Закрывает верх ската, в цвет листа.", kind: "ridge" },
  { title: "Планки", text: "Торцевые и карнизные: защищают края крыши.", kind: "plank" },
  { title: "Водосток", text: "Желоба и воронки в цвет крыши.", kind: "gutter" },
  { title: "Трубы", text: "Водосточные трубы и крепления.", kind: "pipe" },
];
const otherEntries = catalogEntries().filter((e) => !e.models.some((m) => m.slug === model.slug));
---

<Breadcrumbs
  items={[
    { name: "Главная", href: "/" },
    { name: "Каталог", href: "/catalog" },
    { name: "Металлочерепица", href: "/catalog/metallocherepitsa" },
    { name: model.name, href: base },
    ...(isModelPage ? [] : [{ name: variantName, href: `${base}/${variant.slug}` }]),
  ]}
/>

<article class="product-view">
  <div class="product-view__visual">
    <div class="product-view__views" data-views>
      <div class="art-box product-view__art" data-view="sheet">
        <canvas
          data-art
          data-kind="tile"
          data-model={look.art}
          data-color={colorInfo.hex}
          role="img"
          aria-label={`Металлочерепица ${model.name}, цвет ${colorText}`}
        ></canvas>
        <span class="product-view__caption">
          {colorText} · {coating.name}
        </span>
      </div>
      <div class="art-box product-view__art" data-view="house" hidden>
        <img
          src={`/images/house/${colorSlug(color)}.svg`}
          alt={`Дом с крышей цвета ${colorText}`}
          width="760"
          height="600"
          loading="lazy"
        />
        <span class="product-view__caption">{colorText} на доме</span>
      </div>
      <div class="art-box product-view__art product-view__profile" data-view="profile" hidden>
        <svg
          viewBox="0 0 640 520"
          role="img"
          aria-label={`Профиль листа${model.width ? `: ширина ${model.width} мм` : ""}`}
        >
          <path
            d="M60 260 C80 260 84 220 104 220 C124 220 128 260 148 260 C168 260 172 220 192 220 C212 220 216 260 236 260 C256 260 260 220 280 220 C300 220 304 260 324 260 C344 260 348 220 368 220 C388 220 392 260 412 260 C432 260 436 220 456 220 C476 220 480 260 500 260 C520 260 524 220 544 220 C564 220 570 250 580 256"
            fill="none"
            stroke="#141414"
            stroke-width="3"
            stroke-linejoin="round"
          ></path>
          <path
            d="M60 300 V320 M580 300 V320 M60 310 H580"
            stroke="#9a9a9a"
            stroke-width="1.2"
            fill="none"
          ></path>
          <text x="320" y="342" font-size="15" fill="#555555" text-anchor="middle">
            {model.width ? `ширина листа ${model.width} мм` : "волна поперёк листа"}
          </text>
          <g transform="translate(60 380)">
            <path d="M0 80 H520" stroke="#141414" stroke-width="3"></path>
            <path
              d="M0 80 L0 40 C20 40 30 30 40 30 H120 L120 60 C140 60 150 50 160 50 H240 L240 20 C260 20 270 10 280 10 H360 L360 40 C380 40 390 30 400 30 H480 L480 60"
              fill="none"
              stroke="#141414"
              stroke-width="3"
              stroke-linejoin="round"
            ></path>
            <text x="260" y="108" font-size="15" fill="#555555" text-anchor="middle">
              вид сбоку: ряды со ступенькой
            </text>
          </g>
        </svg>
      </div>
    </div>
    <div class="view-switch" role="group" aria-label="Вид товара" data-nosnippet>
      <button type="button" data-view-btn="sheet" aria-pressed="true">
        Лист
      </button>
      <button type="button" data-view-btn="house" aria-pressed="false">
        На доме
      </button>
      <button type="button" data-view-btn="profile" aria-pressed="false">
        Профиль
      </button>
    </div>
    <p class="product-view__note">
      Цвет на экране может отличаться от настоящего. Образцы цвета покажем вживую или пришлём фото.
    </p>
    <section class="product-specs" aria-labelledby="specs-title">
      <h2 id="specs-title">Характеристики</h2>
      <dl>
        <dt>Модель</dt>
        <dd>{model.name}</dd>
        {model.width && (
          <>
            <dt>Ширина листа</dt>
            <dd>{model.width} мм</dd>
          </>
        )}
        <dt>Толщина металла</dt>
        <dd>{formatThickness(coating.thickness)}</dd>
        <dt>Покрытие</dt>
        <dd>{coating.name}</dd>
        <dt>Класс покрытия</dt>
        <dd>{coating.class}</dd>
        <dt>Полимерный слой</dt>
        <dd>{coating.layer}</dd>
        <dt>Цвет</dt>
        <dd>{colorText}</dd>
        <dt>Гарантия</dt>
        <dd>{warranty ? `${warranty} лет` : "уточнит менеджер"}</dd>
        <dt>Наличие</dt>
        <dd>{coating.stock === "atyrau" ? "склад в Атырау" : "под заказ"}</dd>
        {price && (
          <>
            <dt>Цена за м²</dt>
            <dd>{formatPrice(price)}</dd>
          </>
        )}
      </dl>
    </section>
  </div>

  <div class="product-view__info">
    <p class="product-view__kicker">
      Металлочерепица · {look.type.toLowerCase()}{" "}
      {model.family ? "· одна модель в четырёх исполнениях" : ""}
    </p>
    <h1 class:list={["product-view__title", { "product-view__title_variant": !isModelPage }]}>
      Металлочерепица {model.name}
      {!isModelPage &&
        `, ${coating.name} ${formatThickness(coating.thickness)}, ${colorInfo.label}`}
      <span class="product-view__subtitle">
        {coating.name}, {formatThickness(coating.thickness)}, {colorInfo.label}
        {colorInfo.label !== colorInfo.name && ` ${colorInfo.name}`}
      </span>
    </h1>

    <p class:list={["stock", `stock_${coating.stock}`]}>
      <b>{stock.label}</b>
      <span>{stock.text}</span>
    </p>

    <ul class="product-view__facts">
      {warranty && (
        <li>
          <b>{warranty} лет</b> гарантия
        </li>
      )}
      <li>
        <b>{coating.class}</b> класс покрытия
      </li>
      <li>
        <b>{formatThickness(coating.thickness)}</b> металл
      </li>
      {model.width && (
        <li>
          <b>{model.width} мм</b> ширина листа
        </li>
      )}
    </ul>

    {model.family && (
      <div class="picker" role="group" aria-label="Исполнение">
        <p class="picker__label">Исполнение</p>
        <div class="picker__versions">
          {versionCards.map(({ m, href, from }) => (
            <a
              href={href}
              class:list={["picker__version", { picker__version_active: m.slug === model.slug }]}
              aria-current={m.slug === model.slug ? "true" : undefined}
            >
              <b>{m.family!.version}</b>
              <span>от {formatPrice(from)}</span>
            </a>
          ))}
        </div>
        <p class="picker__note">{model.family.versionNote}</p>
      </div>
    )}

    <div class="picker" role="group" aria-label="Покрытие">
      <p class="picker__label picker__label_row">
        Покрытие
        {inStockNames.size > 0 && (
          <span class="picker__hint">
            <span class="picker__stock" aria-hidden="true" /> — есть в Атырау
          </span>
        )}
      </p>
      <div class="picker__options picker__options_coats">
        {coatingCards.map(({ c, href, price: p, active, inStock, extra }) => (
          <a
            href={href}
            class:list={["picker__chip", "picker__coat", { picker__chip_active: active }]}
            aria-current={active ? "true" : undefined}
          >
            <span class="picker__coat-row">
              <span class="picker__coat-name">
                {c.name}
                {inStock && (
                  <span class="picker__stock" title="В наличии в Атырау">
                    <span class="sr-only">, в наличии в Атырау</span>
                  </span>
                )}
              </span>
              {p && <b>{formatPrice(p)}</b>}
            </span>
            <span class="picker__coat-row picker__coat-meta">
              <span>
                {c.class} · {formatThickness(c.thickness)}
              </span>
              <span>{extra}</span>
            </span>
          </a>
        ))}
      </div>
    </div>

    <div class="picker" role="group" aria-label="Цвет">
      <p class="picker__label">
        {isModelPage ? (
          <>
            Цвет:{" "}
            <span>
              {colorInfo.label}
              {colorInfo.label !== colorInfo.name && `, ${colorInfo.name}`}
            </span>
          </>
        ) : (
          <>
            Другие цвета {coating.name} {formatThickness(coating.thickness)}{" "}
            <span>· {colorOptions.length} цв.</span>
          </>
        )}
      </p>
      <div class="picker__options picker__options_colors">
        {colorOptions.map((v) => {
          const info = colors[v.color]!;
          const active = v.color === color;
          return (
            <a
              href={`${base}/${v.slug}`}
              class:list={["picker__swatch", { picker__swatch_active: active }]}
              style={`--swatch: ${info.hex}`}
              title={`${info.label} ${info.name}`}
              aria-label={`${info.label} ${info.name}`}
              aria-current={active ? "true" : undefined}
            />
          );
        })}
      </div>
    </div>

    <div class="product-view__buy">
      {price && (
        <div class="product-view__price">
          <p class="product-view__price-value">
            {formatPrice(price)} <span>за м²</span>
            <small class="product-view__vat">с НДС</small>
          </p>
          <p class="product-view__price-note">
            Цена с НДС, актуальна на {priceDateOf(model, coating)}.
            {supplierPrices(model, coating).p1 !== undefined &&
              ` На заказы до 50 м² действует наценка.${model.priceNote ? ` ${model.priceNote}` : ""}`}{" "}
            Точную сумму с доставкой рассчитает менеджер.
          </p>
        </div>
      )}

      {price && (
        <div
          class="calc"
          data-nosnippet
          data-price={price}
          data-small-markup={supplierPrices(model, coating).p1 !== undefined ? "" : undefined}
          data-options={JSON.stringify(calcOptions)}
          data-whatsapp={business.phoneE164.replace("+", "")}
        >
          <p class="calc__title">Сколько нужно на вашу крышу?</p>
          <div class="calc__chips" role="radiogroup" aria-label="Как считать">
            <label class="calc__chip">
              <input type="radio" name="calc-mode" value="area" checked />
              <span>Знаю площадь</span>
            </label>
            <label class="calc__chip">
              <input type="radio" name="calc-mode" value="house" />
              <span>По размерам дома</span>
            </label>
          </div>

          <div class="calc__mode" data-mode="area">
            <label class="calc__label" for="calc-area">
              Площадь крыши
            </label>
            <div class="calc__field calc__field_step">
              <button
                type="button"
                class="calc__step"
                data-calc-step="-10"
                aria-label="Уменьшить площадь на 10 м²"
              >
                −
              </button>
              <input
                id="calc-area"
                class="calc__input"
                type="number"
                inputmode="decimal"
                min="1"
                max="100000"
                step="any"
                autocomplete="off"
              />
              <span class="calc__unit">м²</span>
              <button
                type="button"
                class="calc__step"
                data-calc-step="10"
                aria-label="Увеличить площадь на 10 м²"
              >
                +
              </button>
            </div>
          </div>

          <div class="calc__mode" data-mode="house" hidden>
            <div class="calc__fields">
              <div>
                <label class="calc__label" for="calc-length">
                  Длина дома
                </label>
                <div class="calc__field">
                  <input
                    id="calc-length"
                    class="calc__input"
                    type="number"
                    inputmode="decimal"
                    min="1"
                    max="500"
                    step="any"
                    autocomplete="off"
                  />
                  <span class="calc__unit">м</span>
                </div>
              </div>
              <div>
                <label class="calc__label" for="calc-width">
                  Ширина дома
                </label>
                <div class="calc__field">
                  <input
                    id="calc-width"
                    class="calc__input"
                    type="number"
                    inputmode="decimal"
                    min="1"
                    max="500"
                    step="any"
                    autocomplete="off"
                  />
                  <span class="calc__unit">м</span>
                </div>
              </div>
            </div>
            <p class="calc__label">Наклон крыши</p>
            <div class="calc__chips" role="radiogroup" aria-label="Наклон крыши">
              {Object.entries(SLOPES).map(([value, s]) => (
                <label class="calc__chip">
                  <input type="radio" name="calc-slope" value={value} checked={value === "mid"} />
                  <span>
                    {s.label}, ~{s.degrees}°
                  </span>
                </label>
              ))}
            </div>
          </div>

          <p class="calc__label">Тип крыши</p>
          <div class="calc__chips" role="radiogroup" aria-label="Тип крыши">
            {Object.entries(ROOF_TYPES).map(([value, t]) => (
              <label class="calc__chip">
                <input type="radio" name="calc-roof" value={value} checked={value === "gable"} />
                <span>{t.label}</span>
              </label>
            ))}
          </div>

          <p class="calc__error" role="alert" hidden></p>
          <div class="calc__result" aria-live="polite" hidden>
            <p class="calc__total">
              Примерно <b class="calc__sum"></b>
            </p>
            <p class="calc__detail"></p>
            <p class="calc__note" hidden>
              Для заказа до 50 м² цена будет выше: на небольшие заказы действует наценка.
            </p>
            <div class="calc__trims" hidden>
              <p class="calc__subtitle">Ещё понадобится</p>
              <ul class="calc__trims-list"></ul>
              <p class="calc__detail">Цену доборных элементов рассчитает менеджер.</p>
            </div>
            <div class="calc__compare">
              <p class="calc__subtitle">С другим покрытием на эту площадь</p>
              <ul class="calc__compare-list"></ul>
            </div>
            <a class="calc__whatsapp" href="#" target="_blank" rel="noopener">
              Отправить расчёт в WhatsApp
            </a>
          </div>
        </div>
      )}

      <div class="product-view__actions">
        <a href="#ex1" rel="modal:open" class="s-btn s-btn--dark product-view__order">
          Узнать стоимость
        </a>
        <a href={waProduct} class="s-btn s-btn--wa" target="_blank" rel="noopener">
          WhatsApp
        </a>
      </div>
    </div>
    <div data-nosnippet>
      <ul class="product-trust">
        <li>
          <span class="product-trust__icon" aria-hidden="true">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 6h11v9H3zM14 9h4l3 3v3h-7"></path>
              <circle cx="7" cy="17" r="1.8"></circle>
              <circle cx="17" cy="17" r="1.8"></circle>
            </svg>
          </span>
