---
// Страница модели/варианта металлочерепицы: выбор покрытия, толщины и цвета
import TileVisual from "./TileVisual.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { colors } from "../../data/catalog/colors";
import {
  catalogEntries,
  defaultVariant,
  familyOf,
  formatPrice,
  formatThickness,
  priceDateOf,
  priceOf,
  supplierPrices,
  warrantyOf,
  stockInfo,
  variantsOf,
  type Model,
  type Variant,
} from "../../data/catalog/metal-tile";
import { business } from "../../lib/business";

interface Props {
  variant: Variant;
}

const { variant } = Astro.props;
const { model, coating, color } = variant;
const base = `/catalog/metallocherepitsa/${model.slug}`;
const all = variantsOf(model);
const colorInfo = colors[color]!;

// Ссылка на вариант с нужным покрытием/толщиной: цвет сохраняем, если он есть
const linkTo = (name: string, thickness?: number) => {
  const sameName = all.filter((v) => v.coating.name === name);
  const pool = thickness ? sameName.filter((v) => v.coating.thickness === thickness) : sameName;
  const pick = pool.find((v) => v.color === color) ?? pool[0]!;
  return `${base}/${pick.slug}`;
};

const coatingNames = [...new Set(model.coatings.map((c) => c.name))];
const thicknesses = model.coatings.filter((c) => c.name === coating.name);
const colorOptions = all.filter(
  (v) => v.coating.name === coating.name && v.coating.thickness === coating.thickness,
);
// Исполнения семейства (Монтерроса A/S/M/X): сохраняем покрытие, толщину и цвет, если есть
const versions = familyOf(model);
const versionLink = (m: Model) => {
  const vs = variantsOf(m);
  const pick =
    vs.find(
      (v) =>
        v.coating.name === coating.name &&
        v.coating.thickness === coating.thickness &&
        v.color === color,
    ) ??
    vs.find((v) => v.coating.name === coating.name && v.color === color) ??
    vs.find((v) => v.coating.name === coating.name) ??
    defaultVariant(m);
  return `/catalog/metallocherepitsa/${m.slug}/${pick.slug}`;
};
const price = priceOf(model, coating);
const warranty = warrantyOf(model, coating);
const stock = stockInfo[coating.stock];
// Покрытия, которые есть в Атырау (хотя бы в одной толщине)
const inStockNames = new Set(model.coatings.filter((c) => c.stock === "atyrau").map((c) => c.name));
const site = Astro.site ?? new URL("https://velum.kz");
const productName = `Металлочерепица ${model.name} ${coating.name} ${formatThickness(coating.thickness)}, ${colorInfo.label}`;
const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: productName,
  description: model.summary,
  color: `${colorInfo.label} ${colorInfo.name}`,
  material: "Оцинкованная сталь с полимерным покрытием",
  url: new URL(Astro.url.pathname, site).href,
  ...(price && {
    offers: {
      "@type": "Offer",
      price,
      priceCurrency: "KZT",
      availability:
        coating.stock === "atyrau" ? "https://schema.org/InStock" : "https://schema.org/BackOrder",
      unitText: "м²",
      seller: { "@type": "Organization", name: business.name },
    },
  }),
};

const otherEntries = catalogEntries().filter((e) => !e.models.some((m) => m.slug === model.slug));
---

<Breadcrumbs
  items={[
    { name: "Главная", href: "/" },
    { name: "Каталог", href: "/catalog" },
    { name: "Металлочерепица", href: "/catalog/metallocherepitsa" },
    { name: model.name, href: base },
  ]}
/>

<article class="product-view">
  <div class="product-view__visual">
    <TileVisual hex={colorInfo.hex} label={`Цвет ${colorInfo.label} ${colorInfo.name}`} />
    <p class="product-view__note">
      Цвет на экране может отличаться от настоящего. Образцы покажем в офисе.
    </p>
  </div>

  <div class="product-view__info">
    <h1 class="product-view__title">
      Металлочерепица {model.name}
      <span class="product-view__subtitle">
        {coating.name}, {formatThickness(coating.thickness)}, {colorInfo.label}
        {colorInfo.label !== colorInfo.name && ` ${colorInfo.name}`}
      </span>
    </h1>

    <p class:list={["stock", `stock_${coating.stock}`]}>
      <b>{stock.label}</b>
      <span>{stock.text}</span>
    </p>

    <ul class="product-view__facts">
      {warranty && (
        <li>
          <b>{warranty} лет</b> гарантия
        </li>
      )}
      <li>
        <b>{coating.class}</b> класс покрытия
      </li>
      {model.width && (
        <li>
          <b>{model.width} мм</b> ширина листа
        </li>
      )}
    </ul>

    {model.family && (
      <div class="picker" role="group" aria-label="Исполнение">
        <p class="picker__label">
          Исполнение: <span>{model.family.versionNote}</span>
        </p>
        <div class="picker__options">
          {versions.map((m) => (
            <a
              href={versionLink(m)}
              class:list={["picker__chip", { picker__chip_active: m.slug === model.slug }]}
              aria-current={m.slug === model.slug ? "true" : undefined}
            >
              {m.family!.version}
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="picker" role="group" aria-label="Покрытие">
      <p class="picker__label">Покрытие</p>
      <div class="picker__options">
        {coatingNames.map((name) => (
          <a
            href={linkTo(name)}
            class:list={["picker__chip", { picker__chip_active: name === coating.name }]}
            aria-current={name === coating.name ? "true" : undefined}
          >
            {name}
            {inStockNames.has(name) && (
              <span class="picker__stock" title="В наличии в Атырау">
                <span class="sr-only">, в наличии в Атырау</span>
              </span>
            )}
          </a>
        ))}
      </div>
      {inStockNames.size > 0 && (
        <p class="picker__hint">
          <span class="picker__stock" aria-hidden="true" /> есть на складе в Атырау, остальные — под
          заказ
        </p>
      )}
    </div>

    <div class="picker" role="group" aria-label="Толщина металла">
      <p class="picker__label">Толщина металла</p>
      <div class="picker__options">
        {thicknesses.map((c) => (
          <a
            href={linkTo(c.name, c.thickness)}
            class:list={[
              "picker__chip",
              { picker__chip_active: c.thickness === coating.thickness },
            ]}
            aria-current={c.thickness === coating.thickness ? "true" : undefined}
          >
            {formatThickness(c.thickness)}
          </a>
        ))}
      </div>
    </div>

    <div class="picker" role="group" aria-label="Цвет">
      <p class="picker__label">
        Цвет:{" "}
        <span>
          {colorInfo.label}
          {colorInfo.label !== colorInfo.name && `, ${colorInfo.name}`}
        </span>
      </p>
      <div class="picker__options picker__options_colors">
        {colorOptions.map((v) => {
          const info = colors[v.color]!;
          const active = v.color === color;
          return (
            <a
              href={`${base}/${v.slug}`}
              class:list={["picker__swatch", { picker__swatch_active: active }]}
              style={`--swatch: ${info.hex}`}
              title={`${info.label} ${info.name}`}
              aria-label={`${info.label} ${info.name}`}
              aria-current={active ? "true" : undefined}
            />
          );
        })}
      </div>
    </div>

    {price && (
      <div class="product-view__price">
        <p class="product-view__price-value">
          {formatPrice(price)} <span>за м²</span>
        </p>
        <p class="product-view__price-note">
          Цена с НДС, актуальна на {priceDateOf(model, coating)}.
          {supplierPrices(model, coating).p1 !== undefined &&
            ` На заказы до 50 м² действует наценка.${model.priceNote ? ` ${model.priceNote}` : ""}`}{" "}
          Точную сумму с доставкой рассчитает менеджер.
        </p>
      </div>
    )}

    <div class="product-view__actions">
      <a href="#ex1" rel="modal:open" class="btn btn_theme_grab btn_size_l product-view__btn">
        <span class="btn__text">Узнать стоимость</span>
      </a>
      <a
        href={`tel:${business.phoneE164}`}
        class="btn btn_theme_outline-grab btn_size_l product-view__btn"
      >
        <span class="btn__text">Позвонить</span>
      </a>
    </div>
  </div>
</article>

<script type="application/ld+json" set:html={JSON.stringify(productLd)} />
<section class="product-details">
  <div class="product-details__text">
    <h2>О модели</h2>
    {model.description.map((p) => (
      <p>{p}</p>
    ))}
    <p>
      Покрытие {coating.name} относится к классу «{coating.class}»: толщина полимерного слоя{" "}
      {coating.layer}
      {warranty ? `, гарантия ${warranty} лет` : ""}.
    </p>
  </div>
  <div class="product-details__specs">
    <h2>Характеристики</h2>
    <dl>
      <dt>Модель</dt>
      <dd>{model.name}</dd>
      <dt>Покрытие</dt>
      <dd>{coating.name}</dd>
      <dt>Класс покрытия</dt>
      <dd>{coating.class}</dd>
      <dt>Толщина полимерного слоя</dt>
      <dd>{coating.layer}</dd>
      <dt>Толщина металла</dt>
      <dd>{formatThickness(coating.thickness)}</dd>
      <dt>Цвет</dt>
      <dd>
        {colorInfo.label}
        {colorInfo.label !== colorInfo.name && `, ${colorInfo.name}`}
      </dd>
      {model.width && (
        <>
          <dt>Полная ширина листа</dt>
          <dd>{model.width} мм</dd>
        </>
      )}
      {warranty && (
        <>
          <dt>Гарантия</dt>
          <dd>{warranty} лет</dd>
        </>
      )}
      {price && (
        <>
          <dt>Цена за м²</dt>
          <dd>{formatPrice(price)}</dd>
        </>
      )}
    </dl>
  </div>
</section>

<section class="other-models">
  <h2>Другие модели металлочерепицы</h2>
  <ul class="other-models__list">
    {otherEntries.map((e) => (
      <li>
        <a href={`/catalog/metallocherepitsa/${e.slug}`}>{e.name}</a>
      </li>
    ))}
  </ul>
</section>
