<script>
  // Вид товара: лист, на доме, профиль
  document.addEventListener("astro:page-load", () => {
    const views = document.querySelector<HTMLElement>("[data-views]");
    if (!views) return;
    document.querySelectorAll<HTMLButtonElement>("[data-view-btn]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const id = btn.dataset.viewBtn;
        document
          .querySelectorAll<HTMLButtonElement>("[data-view-btn]")
          .forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        views.querySelectorAll<HTMLElement>("[data-view]").forEach((v) => {
          v.hidden = v.dataset.view !== id;
        });
      }),
    );
  });
</script>
