---
// Хлебные крошки с разметкой BreadcrumbList для поисковиков
interface Props {
  items: { name: string; href: string }[];
}

const { items } = Astro.props;
const site = Astro.site ?? new URL("https://velum.kz");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.name,
    item: new URL(item.href, site).href,
  })),
};
---

<nav class="breadcrumbs" aria-label="Навигация по разделам">
  <ol>
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={item.href}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    color: #666;
  }
  .breadcrumbs li:not(:last-child)::after {
    content: "/";
    margin-left: 0.5rem;
    color: #bbb;
  }
  .breadcrumbs a {
    color: inherit;
  }
</style>
