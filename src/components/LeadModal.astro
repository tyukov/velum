---
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
// Модальное окно с формой заявки. Открывается ссылками rel="modal:open" href="#<id>"
interface Props {
  id: string;
  title: string;
  submitText: string;
  withMessage?: boolean;
  /** Товар, о котором спрашивают: уходит в заявку скрытым полем */
  product?: string;
}

const { id, title, submitText, withMessage = false, product } = Astro.props;
---

<div id={id} class="modal">
  <form action="/api/send" method="post">
    <input
      type="text"
      name="website"
      class="honeypot"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />
    {product && <input type="hidden" name="product" value={product} />}
    <div class="modal__header">
      <h2 class="modal__box-title">{title}</h2>
      <p class="modal__box-text">
        {product
          ? `${product}. Менеджер перезвонит и назовёт стоимость`
          : "Менеджер перезвонит вам и ответит на вопросы"}
      </p>
    </div>
    <div class="modal__body">
      <div class="form form_required">
        <input
          id={`${id}-name`}
          type="text"
          name="user_name"
          class="modal__input"
          placeholder=" "
          autocomplete="name"
          maxlength="100"
          required
        />
        <label for={`${id}-name`} class="modal__label">
          <span class="modal__label-placeholder">Ваше имя</span>
        </label>
      </div>
      <div class="form form_required">
        <input
          id={`${id}-phone`}
          type="tel"
          name="user_phone"
          class="modal__input"
          placeholder=" "
          required
        />
        <label for={`${id}-phone`} class="modal__label">
          <span class="modal__label-placeholder">Ваш телефон</span>
        </label>
      </div>
      {withMessage && (
        <div class="form">
          <textarea
            id={`${id}-message`}
            name="user_message"
            class="modal__input"
            placeholder=" "
            maxlength="1000"
          />
          <label for={`${id}-message`} class="modal__label">
            <span class="modal__label-placeholder">Ваш вопрос:</span>
          </label>
        </div>
      )}
      {PUBLIC_TURNSTILE_SITE_KEY && (
        <div class="turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} />
      )}
      <button type="submit" class="btn btn_theme_grab btn_size_l btn_wide">
        <span class="btn__text">{submitText}</span>
      </button>
    </div>
    <div class="modal__footer">
      <p class="modal__box-text">
        Нажимая кнопку «{submitText}», вы даёте согласие на обработку персональных данных
        в&nbsp;соответствии с{" "}
        <a href="/privacy" target="_blank">
          политикой конфиденциальности
        </a>
      </p>
    </div>
  </form>
</div>
