---
import { PUBLIC_TURNSTILE_SITE_KEY } from "astro:env/client";
import { business } from "../lib/business";
import "../styles/modal.css";
// Модальное окно с формой заявки. Открывается ссылками rel="modal:open" href="#<id>"
interface Props {
  id: string;
  title: string;
  submitText: string;
  withMessage?: boolean;
  /** Товар, о котором спрашивают: уходит в заявку скрытым полем */
  product?: string;
  /** Для менеджера: цены поставщиков по этому товару (П1/П2), в заявку скрытым полем */
  supply?: string;
}

const { id, title, submitText, withMessage = false, product, supply } = Astro.props;
// Большое окно с эскизом дома — для заявки; «Заказать звонок» — компактное, только форма
const wide = withMessage || !!product;
const wa = `https://wa.me/${business.phoneE164.replace("+", "")}?text=${encodeURIComponent(
  product
    ? `Здравствуйте! Пишу с сайта velum.kz: ${product}`
    : "Здравствуйте! Пишу с сайта velum.kz",
)}`;
---

<div id={id} class:list={["modal", "lead", { lead_wide: wide }]}>
  <div class="lead__grid">
    {wide && (
      <div class="lead__aside" aria-hidden="true">
        <img
          src="/images/house-roof.svg"
          alt=""
          width="760"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <p class="lead__aside-title">Посчитаем крышу под ваш дом</p>
        <ul>
          <li>Перезвоним и посчитаем материалы под ваш дом</li>
          <li>Подскажем, что есть на складе в Атырау</li>
          <li>Без навязчивых звонков и рассылок</li>
        </ul>
      </div>
    )}
    <form action="/api/send" method="post" class="lead__form">
      <input
        type="text"
        name="website"
        class="honeypot"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      {product && <input type="hidden" name="product" value={product} />}
      {supply && <input type="hidden" name="supply" value={supply} />}
      <h2 class="lead__title">{title}</h2>
      <p class="lead__text">
        {product
          ? `${product}. Менеджер перезвонит и рассчитает стоимость под ваш объём.`
          : withMessage
            ? "Укажите имя и телефон. Если знаете размеры крыши — напишите их в вопросе."
            : "Менеджер перезвонит вам и ответит на вопросы."}
      </p>
      <div class="lead__field">
        <label for={`${id}-name`}>Ваше имя</label>
        <input
          id={`${id}-name`}
          type="text"
          name="user_name"
          placeholder="Например, Айдар"
          autocomplete="name"
          maxlength="100"
          required
        />
      </div>
      <div class="lead__field">
        <label for={`${id}-phone`}>Ваш телефон</label>
        <input
          id={`${id}-phone`}
          type="tel"
          name="user_phone"
          placeholder="+7 (7__) ___-__-__"
          required
        />
      </div>
      {withMessage && (
        <div class="lead__field">
          <label for={`${id}-message`}>
            Ваш вопрос <span>— необязательно</span>
          </label>
          <textarea
            id={`${id}-message`}
            name="user_message"
            placeholder="Крыша 120 м², нужна металлочерепица и водосток"
            maxlength="1000"
          />
        </div>
      )}
      {PUBLIC_TURNSTILE_SITE_KEY && (
        <div class="turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} />
      )}
      <button type="submit" class="s-btn s-btn--dark lead__submit">
        {submitText}
      </button>
      <p class="lead__legal">
        Нажимая кнопку «{submitText}», вы даёте согласие на обработку персональных данных в
        соответствии с{" "}
        <a href="/privacy" target="_blank">
          политикой конфиденциальности
        </a>
      </p>
      <a class="lead__wa" href={wa} target="_blank" rel="noopener">
        Или напишите в WhatsApp →
      </a>
    </form>
  </div>
</div>
