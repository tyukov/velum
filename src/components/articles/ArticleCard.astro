---
// Карточка статьи: рисунок, рубрика и время чтения, заголовок, короткое описание
import type { Article } from "../../data/articles";

interface Props {
  article: Article;
  /** Заголовок карточки: h2 в списке, h3 в «Читайте также» */
  level?: 2 | 3;
}

const { article, level = 2 } = Astro.props;
const Heading = `h${level}` as "h2" | "h3";
---

<a class="a-card" href={`/articles/${article.slug}`} data-category={article.category}>
  <div class="a-card__art">
    <img src={`/images/art/${article.art}.svg`} alt="" width="760" height="600" loading="lazy" />
  </div>
  <div class="a-card__body">
    <p class="a-card__meta">
      {article.category} <span>· {article.minutes} мин</span>
    </p>
    <Heading class="a-card__title">{article.title}</Heading>
    <p class="a-card__text">{article.card}</p>
  </div>
</a>

<style>
  .a-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: #ffffff;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition: box-shadow 0.2s;
  }
  .a-card:hover {
    box-shadow: 0 12px 32px rgba(20, 20, 20, 0.08);
  }
  .a-card__art {
    background: var(--paper);
  }
  .a-card__art img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 19 / 13;
    object-fit: cover;
  }
  .a-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 20px 22px;
  }
  .a-card__meta {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-ink);
  }
  .a-card__meta span {
    font-weight: 400;
    color: var(--muted);
  }
  .a-card__title {
    margin: 0;
    font-size: 19px;
    line-height: 1.3;
    font-weight: 600;
  }
  .a-card__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
