---
// Как мы работаем: 6 шагов. На компьютере — ряд, на телефоне — компактная лента сверху вниз.
const steps = [
  ["Заявка", "Уточняем, что нужно"],
  ["Замер", "Выезжаем на объект"],
  ["Смета", "Считаем материалы"],
  ["Оплата", "Фиксируем цену"],
  ["Доставка", "Везём до дома"],
  ["Монтаж", "По смете, если нужен"],
];
---

<section class="s-section s-wrap" aria-labelledby="steps-title">
  <div class="s-section__head">
    <h2 id="steps-title" class="s-h2">
      Как мы работаем
    </h2>
  </div>
  <ol class="steps">
    {steps.map(([title, text], i) => (
      <li class="steps__item">
        <span class="steps__num">{String(i + 1).padStart(2, "0")}</span>
        <div>
          <h3>{title}</h3>
          <p>{text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  /* Компьютер: шесть карточек в ряд, номер в кружке (первый — тёмный) */
  .steps {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps__item {
    padding: 22px;
    border-radius: 20px;
    background: var(--paper-2);
    border: 1px solid #f0ebe4;
  }
  .steps__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #e7e2da;
    background: #ffffff;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  .steps__item:first-child .steps__num {
    background: var(--ink);
    border-color: var(--ink);
    color: #ffffff;
  }
  .steps__item h3 {
    margin: 14px 0 4px;
    font-size: 17px;
    font-weight: 600;
  }
  .steps__item p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 1100px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* Телефон: лента сверху вниз, кружки соединены линией */
  @media (max-width: 640px) {
    .steps {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .steps__item {
      position: relative;
      display: flex;
      gap: 14px;
      align-items: flex-start;
      padding: 0 0 18px;
      border: 0;
      background: none;
    }
    .steps__item:not(:last-child)::before {
      content: "";
      position: absolute;
      left: 16px;
      top: 34px;
      bottom: 0;
      width: 2px;
      background: var(--line);
    }
    .steps__num {
      position: relative;
      flex: none;
    }
    .steps__item h3 {
      margin: 6px 0 2px;
      font-size: 16px;
    }
  }
</style>
