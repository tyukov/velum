---
// Наши работы: реальные фото объектов, по нажатию — крупно (medium-zoom по классу .zoom)
import { Picture } from "astro:assets";
import work1 from "../../assets/img/work-1.jpg";
import work2 from "../../assets/img/work-2.jpg";
import work3 from "../../assets/img/work-3.jpg";
import work4 from "../../assets/img/work-4.jpg";
import work5 from "../../assets/img/work-5.jpg";

const works = [
  { src: work1, alt: "Проект компании в выполненном состоянии" },
  { src: work2, alt: "Завершённая работа по установке кровли" },
  { src: work3, alt: "Монтаж кровельной системы" },
  { src: work4, alt: "Пример выполненного строительного проекта" },
  { src: work5, alt: "Готовый строительный объект" },
];
---

<section id="works" class="s-section s-wrap" aria-labelledby="works-title">
  <div class="s-section__head">
    <h2 id="works-title" class="s-h2">
      Наши работы
    </h2>
  </div>
  <div class="works" tabindex="0" role="region" aria-label="Фото объектов">
    {works.map((w, i) => (
      <figure class={`works__item works__item--${i + 1}`}>
        <Picture
          src={w.src}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[480, 800, 1200]}
          sizes="(max-width: 640px) 80vw, (max-width: 960px) 50vw, 33vw"
          class="zoom works__img"
          alt={w.alt}
        />
      </figure>
    ))}
  </div>
</section>

<style>
  .works {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: clamp(160px, 18vw, 260px);
    gap: 16px;
  }
  .works__item {
    margin: 0;
    border-radius: 20px;
    overflow: hidden;
    background: var(--paper);
  }
  .works__item--1,
  .works__item--2 {
    grid-column: span 3;
  }
  .works__item--3,
  .works__item--4,
  .works__item--5 {
    grid-column: span 2;
  }
  .works__item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Телефон: лента с прокруткой вбок, следующее фото выглядывает */
  @media (max-width: 640px) {
    .works {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .works__item {
      flex: 0 0 80%;
      height: 220px;
      scroll-snap-align: start;
    }
  }
</style>
