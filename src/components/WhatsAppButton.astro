---
// Плавающая кнопка «Написать в WhatsApp» на всех страницах: в Казахстане клиенты чаще пишут,
// чем звонят. Сообщение заполняется заранее — менеджер сразу видит, с какой страницы пишут.
import { business } from "../lib/business";

interface Props {
  /** Что смотрит посетитель — попадает в текст сообщения */
  topic: string;
}

const { topic } = Astro.props;
const text = `Здравствуйте! Пишу с сайта velum.kz: ${topic}`;
const href = `https://wa.me/${business.phoneE164.replace("+", "")}?text=${encodeURIComponent(text)}`;
---

<a
  class="whatsapp-float"
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Написать в WhatsApp"
  title="Написать в WhatsApp"
>
  <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M16.04 3C9.4 3 4 8.36 4 14.95c0 2.1.56 4.16 1.61 5.97L4 29l8.3-2.15a12.1 12.1 0 0 0 3.74.6h.01C22.68 27.45 28 22.1 28 15.5 28 8.9 22.68 3 16.04 3Zm0 22.37h-.01a10 10 0 0 1-5.1-1.4l-.37-.21-4.93 1.28 1.32-4.78-.24-.39a9.83 9.83 0 0 1-1.52-5.25c0-5.46 4.48-9.9 9.99-9.9 5.5 0 9.88 4.62 9.88 10.04 0 5.43-4.5 10.61-9.02 10.61Zm5.47-7.41c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47a9 9 0 0 1-1.66-2.05c-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.57-.48-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.46s1.07 2.86 1.22 3.05c.15.2 2.1 3.2 5.08 4.48.71.31 1.27.5 1.7.63.71.23 1.36.2 1.88.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"
    ></path>
  </svg>
  <span class="whatsapp-float__text">WhatsApp</span>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    /* Ниже модальных окон (10000) и мобильной шапки (9999) */
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 3.5rem;
    padding: 0 1.375rem 0 1rem;
    border-radius: 1.75rem;
    color: #fff;
    background: #157a3f;
    font:
      600 1rem/1 Inter,
      system-ui,
      sans-serif;
    text-decoration: none;
    box-shadow: 0 0.375rem 1.25rem rgb(0 0 0 / 22%);
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }

  .whatsapp-float:hover {
    background: #11663a;
    transform: translateY(-1px);
  }

  @media (min-width: 1100px) {
    .whatsapp-float {
      right: 2rem;
      bottom: 2rem;
    }
  }

  /* На телефоне — круглая кнопка без подписи */
  @media (max-width: 640px) {
    .whatsapp-float {
      width: 3.5rem;
      padding: 0;
      border-radius: 50%;
    }
    .whatsapp-float__text {
      display: none;
    }
  }

  .whatsapp-float:focus-visible {
    outline: 3px solid #ebb683;
    outline-offset: 3px;
  }

  @media print {
    .whatsapp-float {
      display: none;
    }
  }
</style>
