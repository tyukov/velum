---
// Нижняя панель на телефоне: звонок, WhatsApp и заявка всегда под большим пальцем.
// Показывается только там, где на странице есть окно заявки (#ex1).
import { business } from "../lib/business";

interface Props {
  /** Что смотрит посетитель — попадает в текст сообщения WhatsApp */
  topic: string;
}

const { topic } = Astro.props;
const wa = `https://wa.me/${business.phoneE164.replace("+", "")}?text=${encodeURIComponent(`Здравствуйте! Пишу с сайта velum.kz: ${topic}`)}`;
---

<nav class="s-bar" aria-label="Быстрые действия">
  <a class="s-bar__call" href={`tel:${business.phoneE164}`}>
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.9"
      aria-hidden="true"
    >
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
    </svg>
    Звонок
  </a>
  <a class="s-bar__wa" href={wa} target="_blank" rel="noopener">
    WhatsApp
  </a>
  <a class="s-bar__lead" href="#ex1" rel="modal:open">
    Заявка
  </a>
</nav>
