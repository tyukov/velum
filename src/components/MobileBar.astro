---
// Нижняя панель на телефоне: звонок и WhatsApp — кнопками-иконками, главное действие —
// широкой тёмной кнопкой. На странице товара слева ещё цена за м² и наличие.
// Показывается только там, где на странице есть окно заявки (#ex1).
import { business } from "../lib/business";

export interface BarPrice {
  /** «3 075 ₸» */
  price: string;
  /** «В наличии в Атырау» / «Под заказ» */
  stock: string;
  inStock: boolean;
}

interface Props {
  /** Что смотрит посетитель — попадает в текст сообщения WhatsApp */
  topic: string;
  /** Цена и наличие для страницы товара */
  price?: BarPrice;
}

const { topic, price } = Astro.props;
const wa = `https://wa.me/${business.phoneE164.replace("+", "")}?text=${encodeURIComponent(`Здравствуйте! Пишу с сайта velum.kz: ${topic}`)}`;
---

<nav class:list={["s-bar", { "s-bar_price": price }]} aria-label="Быстрые действия">
  {price ? (
    <p class="s-bar__price">
      <b>{price.price}</b> <span>/м²</span>
      <span class:list={["s-bar__stock", { "s-bar__stock_order": !price.inStock }]}>
        {price.stock}
      </span>
    </p>
  ) : (
    <a class="s-bar__icon s-bar__call" href={`tel:${business.phoneE164}`} aria-label="Позвонить">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        aria-hidden="true"
      >
        <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
      </svg>
    </a>
  )}
  <a class="s-bar__icon s-bar__wa" href={wa} target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
      <path
        fill="currentColor"
        d="M16.04 3C9.4 3 4 8.36 4 14.95c0 2.1.56 4.16 1.61 5.97L4 29l8.3-2.15a12.1 12.1 0 0 0 3.74.6h.01C22.68 27.45 28 22.1 28 15.5 28 8.9 22.68 3 16.04 3Zm0 22.37h-.01a10 10 0 0 1-5.1-1.4l-.37-.21-4.93 1.28 1.32-4.78-.24-.39a9.83 9.83 0 0 1-1.52-5.25c0-5.46 4.48-9.9 9.99-9.9 5.5 0 9.88 4.62 9.88 10.04 0 5.43-4.5 10.61-9.02 10.61Zm5.47-7.41c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47a9 9 0 0 1-1.66-2.05c-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.57-.48-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.46s1.07 2.86 1.22 3.05c.15.2 2.1 3.2 5.08 4.48.71.31 1.27.5 1.7.63.71.23 1.36.2 1.88.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"
      ></path>
    </svg>
  </a>
  <a class="s-bar__lead" href="#ex1" rel="modal:open">
    {price ? "Получить расчёт" : "Оставить заявку"}
  </a>
</nav>
