---
// Подвал: тёмный, сверху логотип и кнопки связи, ниже ссылки группами и реквизиты
import Logo from "./Logo.astro";
import { business } from "../lib/business";

const year = new Date().getFullYear();
const wa = `https://wa.me/${business.phoneE164.replace("+", "")}?text=${encodeURIComponent("Здравствуйте! Пишу с сайта velum.kz")}`;
---

<footer class="s-footer">
  <div class="s-wrap s-footer__in">
    <div class="s-footer__top">
      <div class="s-footer__brand">
        <Logo class="logo" />
        <p>Кровельные и фасадные материалы в {business.city}</p>
      </div>
      <div class="s-footer__actions">
        <a class="s-btn s-btn--light" href={`tel:${business.phoneE164}`}>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            aria-hidden="true"
          >
            <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
          </svg>
          Позвонить
        </a>
        <a class="s-btn s-btn--wa" href={wa} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 32 32" aria-hidden="true">
            <path
              fill="currentColor"
              d="M16.04 3C9.4 3 4 8.36 4 14.95c0 2.1.56 4.16 1.61 5.97L4 29l8.3-2.15a12.1 12.1 0 0 0 3.74.6h.01C22.68 27.45 28 22.1 28 15.5 28 8.9 22.68 3 16.04 3Zm0 22.37h-.01a10 10 0 0 1-5.1-1.4l-.37-.21-4.93 1.28 1.32-4.78-.24-.39a9.83 9.83 0 0 1-1.52-5.25c0-5.46 4.48-9.9 9.99-9.9 5.5 0 9.88 4.62 9.88 10.04 0 5.43-4.5 10.61-9.02 10.61Zm5.47-7.41c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47a9 9 0 0 1-1.66-2.05c-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.57-.48-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.46s1.07 2.86 1.22 3.05c.15.2 2.1 3.2 5.08 4.48.71.31 1.27.5 1.7.63.71.23 1.36.2 1.88.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"
            ></path>
          </svg>
          WhatsApp
        </a>
      </div>
    </div>
    <nav class="s-footer__nav" aria-label="Нижнее меню">
      <div>
        <p>Магазин</p>
        <a href="/catalog">Каталог</a>
        <a href="/catalog/metallocherepitsa">Металлочерепица</a>
        <a href="/#calc">Калькулятор</a>
      </div>
      <div>
        <p>Полезное</p>
        <a href="/instructions">Инструкции</a>
        <a href="/articles">Статьи</a>
        <a href="/#works">Наши работы</a>
        <a href="/#reviews">Отзывы</a>
        <a href="/#faq">Вопросы и ответы</a>
      </div>
      <div>
        <p>Связь</p>
        <a href={`tel:${business.phoneE164}`}>{business.phoneDisplay}</a>
        <a href={`mailto:${business.legal.email}`}>{business.legal.email}</a>
        <a href={business.sameAs[0]} target="_blank" rel="noopener">
          Instagram
        </a>
        <p class="s-footer__hours">Работаем {business.hours}</p>
      </div>
    </nav>
    <div class="s-footer__legal">
      <span>
        © {year} {business.legal.name} · ИИН {business.legal.iin} · г. {business.city}
      </span>
      <a href="/privacy">Политика конфиденциальности</a>
    </div>
  </div>
</footer>
