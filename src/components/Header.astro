---
// Шапка сайта: прилипает сверху. На планшете и телефоне меню сворачивается в «≡»
// (раскрывается без скриптов — элемент details), на телефоне вместо номера иконка звонка.
import Logo from "./Logo.astro";
import { business } from "../lib/business";

const path = Astro.url.pathname;
const links = [
  { href: "/catalog", label: "Каталог" },
  { href: "/#calc", label: "Калькулятор" },
  { href: "/#works", label: "Наши работы" },
  { href: "/instructions", label: "Инструкции" },
  { href: "/articles", label: "Статьи" },
];
const wa = (topic?: string) =>
  `https://wa.me/${business.phoneE164.replace("+", "")}?text=${encodeURIComponent(`Здравствуйте! Пишу с сайта velum.kz${topic ? `: ${topic}` : ""}`)}`;
const chips = [
  { label: "Крыша", href: "/catalog/metallocherepitsa" },
  { label: "Фасад", href: wa("фасадные материалы"), ext: true },
  { label: "Забор", href: wa("профнастил для забора"), ext: true },
  { label: "Водосток", href: wa("водосток"), ext: true },
  { label: "Доборные", href: wa("доборные элементы"), ext: true },
];
const current = (href: string) =>
  href.startsWith("/#")
    ? false
    : path === href || (href !== "/catalog" && path.startsWith(href + "/"));
---

<header class="s-header">
  <div class="s-wrap s-header__in">
    <Logo class="logo header__logo" />
    <nav class="s-nav" aria-label="Основное меню">
      {links.map((l) => (
        <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
    <a class="s-header__tel" href={`tel:${business.phoneE164}`}>
      {business.phoneDisplay}
    </a>
    <a href="#ex2" rel="modal:open" class="s-btn s-btn--dark s-btn--sm s-header__call">
      Заказать звонок
    </a>
    <a class="s-header__icon" href={`tel:${business.phoneE164}`} aria-label="Позвонить">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        aria-hidden="true"
      >
        <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
      </svg>
    </a>
    <details class="s-menu">
      <summary aria-label="Меню">
        <svg
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path class="s-menu__open" d="M4 7h16M4 12h16M4 17h16"></path>
          <path class="s-menu__close" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <div class="s-menu__panel">
        <div class="s-menu__chips" role="group" aria-label="Разделы каталога">
          {chips.map((c) => (
            <a
              class="s-menu__chip"
              href={c.href}
              {...(c.ext ? { target: "_blank", rel: "noopener" } : {})}
            >
              {c.label}
            </a>
          ))}
        </div>
        <nav aria-label="Меню">
          {[...links, { href: "#contacts", label: "Контакты" }].map((l) => (
            <a class="s-menu__link" href={l.href}>
              {l.label}
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
        <p class="s-menu__hours">Работаем {business.hours}</p>
        <div class="s-menu__actions">
          <a class="s-btn s-btn--dark" href={`tel:${business.phoneE164}`}>
            Позвонить: {business.phoneDisplay}
          </a>
          <a class="s-btn s-btn--wa" href={wa()} target="_blank" rel="noopener">
            Написать в WhatsApp
          </a>
          <a class="s-btn s-btn--light" href="#ex2" rel="modal:open">
            Заказать звонок
          </a>
        </div>
      </div>
    </details>
  </div>
</header>
