---
// Вопросы и ответы: из одного списка строятся блок на главной и разметка FAQPage для поиска
const faq = [
  {
    q: "Что, если я не знаю, что именно мне нужно?",
    a: "Позвоните или оставьте заявку: менеджер расспросит о вашем объекте, подберёт подходящие материалы и рассчитает их количество.",
  },
  {
    q: "От чего зависит цена?",
    a: "Цена зависит от площади и объёма заказа, модели, покрытия и толщины металла. Отправьте заявку — мы рассчитаем стоимость со скидкой.",
  },
  {
    q: "Какие есть гарантии качественного результата?",
    a: "Мы предоставляем гарантию от завода-производителя до 50 лет на продукцию из оцинкованного металла с полимерным покрытием (и без полимерного покрытия). Сертификаты соответствия ГОСТ и ТУ. Гарантируем отсутствие сквозной коррозии, отслаивания, растрескивания и неравномерного выцветания защитного полимерного покрытия.",
  },
  {
    q: "У вас есть доставка?",
    a: "Да, мы осуществляем доставку продукции до вашего объекта в рамках города и за его пределами.",
  },
  {
    q: "Вы осуществляете монтажные работы?",
    a: "Мы сотрудничаем с квалифицированными субподрядными организациями, поэтому при необходимости сможем предоставить вам качественный сервис.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<section class="promo promo-faq">
  <div class="promo__contet wrap">
    <header class="promo-header">
      <h2 class="promo-header__title">Часто задаваемые вопросы</h2>
      <p class="promo-header__text">
        Ответы на самые популярные вопросы.
        <br />
        Если у вас есть другие – просто{" "}
        <a href="#ex2" rel="modal:open">
          свяжитесь с&nbsp;нами
        </a>
      </p>
    </header>
    <ul class="list faq-list">
      {faq.map(({ q, a }) => (
        <li class="faq-list__item">
          <div class="faq-list__question">
            {q}
            <svg
              class="faq-list_icon_close"
              role="presentation"
              focusable="false"
              width="24px"
              height="24px"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
            >
              <g stroke-width="2px" fill="none" fill-rule="evenodd" stroke-linecap="square">
                <g transform="translate(1.000000, 1.000000)">
                  <path d="M0,11 L22,11"></path>
                  <path d="M11,0 L11,22"></path>
                </g>
              </g>
            </svg>
          </div>
          <div class="faq-list__answer">{a}</div>
        </li>
      ))}
    </ul>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </div>
</section>
