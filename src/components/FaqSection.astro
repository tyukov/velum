---
import { business } from "../lib/business";
// Вопросы и ответы: из одного списка строятся блок на главной и разметка FAQPage для поиска
const faq = [
  {
    q: "Что, если я не знаю, что именно мне нужно?",
    a: "Позвоните или оставьте заявку: менеджер расспросит о вашем объекте, подберёт подходящие материалы и рассчитает их количество.",
  },
  {
    q: "От чего зависит цена?",
    a: "Цена зависит от площади и объёма заказа, модели, покрытия и толщины металла. Отправьте заявку — мы рассчитаем стоимость со скидкой.",
  },
  {
    q: "Какие есть гарантии качественного результата?",
    a: "Мы предоставляем гарантию от завода-производителя до 50 лет на продукцию из оцинкованного металла с полимерным покрытием (и без полимерного покрытия). Сертификаты соответствия ГОСТ и ТУ. Гарантируем отсутствие сквозной коррозии, отслаивания, растрескивания и неравномерного выцветания защитного полимерного покрытия.",
  },
  {
    q: "У вас есть доставка?",
    a: "Да, мы осуществляем доставку продукции до вашего объекта в рамках города и за его пределами.",
  },
  {
    q: "Вы осуществляете монтажные работы?",
    a: "Мы сотрудничаем с квалифицированными субподрядными организациями, поэтому при необходимости сможем предоставить вам качественный сервис.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(({ q, a }) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
const wa = `https://wa.me/${business.phoneE164.replace("+", "")}?text=${encodeURIComponent("Здравствуйте! Пишу с сайта velum.kz: вопрос")}`;
---

<section id="faq" class="s-section s-wrap faq" aria-labelledby="faq-title">
  <div class="faq__aside">
    <h2 id="faq-title" class="s-h2">
      Частые вопросы
    </h2>
    <p>
      Не нашли ответ —{" "}
      <a class="faq__wa" href={wa} target="_blank" rel="noopener">
        напишите нам в WhatsApp
      </a>
    </p>
  </div>
  <ul class="faq-list">
    {faq.map(({ q, a }, i) => (
      <li class="faq-list__item">
        <button
          type="button"
          class:list={["faq-list__question", { active: i === 0 }]}
          aria-controls={`faq-a${i}`}
          data-open={i === 0 ? "" : undefined}
        >
          {q}
          <svg
            class="faq-list_icon_close"
            aria-hidden="true"
            width="24"
            height="24"
            viewBox="0 0 24 24"
          >
            <g stroke-width="1.8" fill="none" stroke-linecap="round">
              <path d="M7 12h10M12 7v10"></path>
            </g>
          </svg>
        </button>
        <div
          class="faq-list__answer"
          id={`faq-a${i}`}
          style={i === 0 ? "max-height: none" : undefined}
        >
          <p>{a}</p>
        </div>
      </li>
    ))}
  </ul>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 20px 64px;
    align-items: start;
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  .faq__aside p {
    margin: 14px 0 20px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }
  .faq-list {
    grid-column: span 2;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .faq-list__item {
    padding: 0;
    border-bottom: 1px solid var(--line);
  }
  .faq-list__question {
    display: block;
    width: 100%;
    min-height: 56px;
    padding: 18px 48px 18px 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    text-align: left;
    color: var(--ink);
  }
  .faq-list__question:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  /* Плюс в кружке; у открытого вопроса поворачивается в крестик */
  .faq-list_icon_close {
    width: 32px;
    height: 32px;
    padding: 3px;
    box-sizing: border-box;
    border: 1px solid #e3ddd3;
    border-radius: 50%;
    stroke: var(--ink);
    top: calc(50% - 16px);
  }
  .faq-list__question.active .faq-list_icon_close {
    stroke: var(--ink);
    background: var(--paper);
  }
  .faq__wa {
    color: var(--wa);
    font-weight: 600;
  }
  .faq-list__answer p {
    margin: 0;
    padding: 0 0 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text);
  }
  @media (max-width: 960px) {
    .faq-list {
      grid-column: auto;
    }
  }
  @media (max-width: 640px) {
    .faq__aside .s-btn {
      width: 100%;
    }
    .faq-list__question {
      font-size: 16px;
      padding-block: 14px;
    }
  }
</style>
